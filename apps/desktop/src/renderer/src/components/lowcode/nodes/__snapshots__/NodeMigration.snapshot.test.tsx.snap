  class="min-w-[180px] max-w-[280px] border-2 border-t-white border-l-white border-b-black border-r-black bg-mc-surface shadow-[4px_4px_0_rgba(0,0,0,0.5)] !border-mc-accent "
  role="group"
  style="background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 3px 3px;"
>
  <div
    class="flex items-center gap-1.5 border-2 border-t-white border-l-white border-b-black border-r-black bg-mc-btn px-2"
    style="height: 28px;"
  >
    <div
      class="h-4 w-1"
      style="background-color: rgb(216, 138, 138);"
    />
    <span
      class="truncate text-[10px] font-medium"
      style="color: rgb(216, 138, 138);"
    >
      新物品
    </span>
    <span
      class="text-[10px] text-mc-text"
    >
      普通
    </span>
    <button
      aria-label="设置"
      class="ml-auto border border-t-white border-l-white border-b-black border-r-black bg-mc-btn px-1 text-[10px] hover:bg-mc-btn-hover active:bg-mc-btn-active"
      type="button"
    >
      ⚙
    </button>
    <button
      aria-label="折叠"
      class="border border-t-white border-l-white border-b-black border-r-black bg-mc-btn px-1 text-[10px] hover:bg-mc-btn-hover active:bg-mc-btn-active"
      type="button"
    >
      ▾
    </button>
  </div>
  <div
    class="space-y-0.5 px-3 py-2 text-[11px] text-mc-text"
  >
    <div
      class="text-mc-mute"
    >
      ID: 
      new_item
    </div>
    <div
      class="flex gap-2 text-mc-dim"
    >
      <span>
        misc
      </span>
      <span>
        堆叠 
        64
      </span>
    </div>
  </div>
  <div
    aria-label="端口"
    class="flex justify-between gap-2 border-t-2 border-t-black border-b-white border-l-white border-r-white px-2 py-1"
    role="list"
  >
    <div
      class="flex flex-col gap-1"
    >
      <div
        class="flex items-center gap-1 text-[10px] text-mc-text"
      >
        <span
          class="select-none"
        >
          物品
        </span>
        <div
          class="react-flow__handle react-flow__handle-right nodrag nopan source connectable connectablestart connectableend connectionindicator"
          data-handleid="out"
          data-handlepos="right"
          data-id="null-out-source"
          style="width: 8px; height: 8px; border-radius: 0; background: rgb(216, 138, 138); border: 1px solid rgba(0, 0, 0, 0.8); box-shadow: inset 2px 2px 0 rgba(0,0,0,0.6);"
        />
      </div>
    </div>
  </div>
</div>
`;

