exports[`节点迁移快照测试 > math_operation 节点展开状态快照 1`] = `
<div
  aria-label="数学运算 积木"
  data-shape="reporter"
  data-testid="puzzle-block"
  role="group"
  style="position: relative; width: fit-content;"
>
  <div
    style="background: rgb(29, 157, 181); border-radius: 14px; color: rgb(255, 255, 255); font-size: 12px; min-width: 208px; max-width: 264px; position: relative;"
  >
    <div
      style="display: flex; align-items: center; gap: 6px; padding: 7px 10px 5px;"
    >
      <span
        style="font-weight: 700; white-space: nowrap;"
      >
        数学运算
      </span>
      <span
        style="margin-left: auto; display: flex; gap: 2px;"
      >
        <button
          aria-label="折叠积木"
          style="background: transparent; color: rgb(255, 255, 255); cursor: pointer; padding: 2px; display: flex;"
          type="button"
        >
          <svg
            class="lucide lucide-chevron-up"
            fill="none"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m18 15-6-6-6 6"
            />
          </svg>
        </button>
        <button
          aria-label="打开节点设置"
          style="background: transparent; color: rgb(255, 255, 255); cursor: pointer; padding: 2px; display: flex;"
          type="button"
        >
          <svg
            class="lucide lucide-settings"
            fill="none"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
            />
            <circle
              cx="12"
              cy="12"
              r="3"
            />
          </svg>
        </button>
      </span>
    </div>
    <div
      style="padding: 2px 12px 8px; display: flex; flex-direction: column; gap: 2px;"
    >
      <div
        data-testid="block-row-left-a"
        style="position: relative; display: flex; align-items: center; gap: 6px; min-height: 22px;"
      >
        <div
          class="react-flow__handle react-flow__handle-left nodrag nopan target connectable connectablestart connectableend connectionindicator"
          data-handleid="a"
          data-handlepos="left"
          data-id="null-a-target"
          style="position: absolute; top: 50%; transform: translateY(-50%); left: -6px; width: 12px; height: 12px; border-radius: 50%; background: rgb(255, 255, 255); border: 3px solid rgb(18, 107, 124); box-sizing: border-box;"
        />
        <span
          style="opacity: 0.85; white-space: nowrap;"
        >
          A
        </span>
        <button
          aria-label="编辑A（行内编辑）"
          class="nodrag"
          data-testid="inline-value-left-a"
          style="margin-left: auto; background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 1px 8px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: monospace; font-size: 11px; color: rgb(255, 255, 255); border: 1px solid transparent; cursor: text; text-align: right;"
          type="button"
        >
          0
        </button>
      </div>
      <div
        data-testid="block-row-left-op"
        style="position: relative; display: flex; align-items: center; gap: 6px; min-height: 22px;"
      >
        <div
          class="react-flow__handle react-flow__handle-left nodrag nopan target connectable connectablestart connectableend connectionindicator"
          data-handleid="op"
          data-handlepos="left"
          data-id="null-op-target"
          style="position: absolute; top: 50%; transform: translateY(-50%); left: -6px; width: 12px; height: 12px; border-radius: 50%; background: rgb(255, 255, 255); border: 3px solid rgb(18, 107, 124); box-sizing: border-box;"
        />
        <span
          style="opacity: 0.85; white-space: nowrap;"
        >
          运算符
        </span>
        <button
          aria-label="编辑运算符（行内编辑）"
          class="nodrag"
          data-testid="inline-value-left-op"
          style="margin-left: auto; background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 1px 8px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: monospace; font-size: 11px; color: rgb(255, 255, 255); border: 1px solid transparent; cursor: text; text-align: right;"
          type="button"
        >
          +
        </button>
      </div>
      <div
        data-testid="block-row-left-b"
        style="position: relative; display: flex; align-items: center; gap: 6px; min-height: 22px;"
      >
        <div
          class="react-flow__handle react-flow__handle-left nodrag nopan target connectable connectablestart connectableend connectionindicator"
          data-handleid="b"
          data-handlepos="left"
          data-id="null-b-target"
          style="position: absolute; top: 50%; transform: translateY(-50%); left: -6px; width: 12px; height: 12px; border-radius: 50%; background: rgb(255, 255, 255); border: 3px solid rgb(18, 107, 124); box-sizing: border-box;"
        />
        <span
          style="opacity: 0.85; white-space: nowrap;"
        >
          B
        </span>
        <button
          aria-label="编辑B（行内编辑）"
          class="nodrag"
          data-testid="inline-value-left-b"
          style="margin-left: auto; background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 1px 8px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: monospace; font-size: 11px; color: rgb(255, 255, 255); border: 1px solid transparent; cursor: text; text-align: right;"
          type="button"
        >
          0
        </button>
      </div>
      <div
        data-testid="block-row-right-result"
        style="position: relative; display: flex; align-items: center; gap: 6px; min-height: 22px;"
      >
        <div
          class="react-flow__handle react-flow__handle-right nodrag nopan source connectable connectablestart connectableend connectionindicator"
          data-handleid="result"
          data-handlepos="right"
          data-id="null-result-source"
          style="position: absolute; top: 50%; transform: translateY(-50%); right: -6px; width: 12px; height: 12px; border-radius: 50%; background: rgb(255, 255, 255); border: 3px solid rgb(18, 107, 124); box-sizing: border-box;"
        />
        <span
          style="opacity: 0.85; white-space: nowrap;"
        >
          结果
        </span>
        <span
          style="margin-left: auto; background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 1px 8px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: monospace; font-size: 11px;"
        >
          —
        </span>
      </div>
    </div>
  </div>
</div>
`;

