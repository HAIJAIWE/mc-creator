          data-handleid="saturation"
          data-handlepos="left"
          data-id="null-saturation-target"
          style="position: absolute; top: 50%; transform: translateY(-50%); left: -6px; width: 12px; height: 12px; border-radius: 50%; background: rgb(255, 255, 255); border: 3px solid rgb(173, 92, 18); box-sizing: border-box;"
        />
