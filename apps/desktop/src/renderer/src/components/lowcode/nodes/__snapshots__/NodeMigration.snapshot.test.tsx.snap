        />
        <span
          style="opacity: 0.85; white-space: nowrap;"
        >
          结果
        </span>
        <span
          style="margin-left: auto; background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 1px 8px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: monospace; font-size: 11px;"
        >
          —
        </span>
      </div>
      <div
        data-testid="block-row-right-on_true"
        style="position: relative; display: flex; align-items: center; gap: 6px; min-height: 22px;"
      >
        <div
