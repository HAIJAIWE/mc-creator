          data-handlepos="right"
          data-id="null-loop_body-source"
          style="position: absolute; top: 50%; transform: translateY(-50%); right: -6px; width: 12px; height: 12px; border-radius: 50%; background: rgb(255, 255, 255); border: 3px solid rgb(30, 116, 70); box-sizing: border-box;"
        />
        <span
          aria-hidden="true"
          style="width: 7px; height: 7px; transform: rotate(45deg); background: rgb(255, 255, 255); opacity: 0.9; flex-shrink: 0;"
        />
        <span
          style="opacity: 0.85; white-space: nowrap;"
        >
          循环体
        </span>
        <span
          style="margin-left: auto; background: rgba(0, 0, 0, 0.28); border-radius: 10px; padding: 1px 8px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: monospace; font-size: 11px;"
        >
          —
        </span>
      </div>
    </div>
  </div>
  <div
    class="react-flow__handle react-flow__handle-bottom nodrag nopan source connectable connectablestart connectableend connectionindicator"
    data-handleid="done"
    data-handlepos="bottom"
    data-id="null-done-source"
    data-testid="block-tab"
    style="bottom: -11px; width: 34px; height: 18px; background: transparent; z-index: 10;"
  />
</div>
`;
