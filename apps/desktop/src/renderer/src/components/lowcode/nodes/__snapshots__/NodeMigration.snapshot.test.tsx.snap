      <span
        class="text-mc-dim"
      >
        int
      </span>
       = 
      <span
        class="font-mono text-mc-text"
      >
        0
      </span>
    </div>
  </div>
  <div
    aria-label="端口"
    class="flex justify-between gap-2 border-t-2 border-t-black border-b-white border-l-white border-r-white px-2 py-1"
    role="list"
  >
    <div
      class="flex flex-col gap-1"
    >
      <div
        class="flex items-center gap-1 text-[10px] text-mc-text"
      >
        <span
          class="select-none"
        >
          变量
          <span
            class="text-mc-mute"
          >
            []
          </span>
        </span>
        <div
          class="react-flow__handle react-flow__handle-right nodrag nopan source connectable connectablestart connectableend connectionindicator"
          data-handleid="value"
          data-handlepos="right"
          data-id="null-value-source"
          style="width: 8px; height: 8px; border-radius: 0; background: rgb(122, 138, 198); border: 1px solid rgba(0, 0, 0, 0.8); box-shadow: inset 2px 2px 0 rgba(0,0,0,0.6);"
        />
      </div>
    </div>
  </div>
</div>
`;

