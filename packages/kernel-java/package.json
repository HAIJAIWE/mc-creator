    "@mc-creator/devkit": "workspace:*",
    "@mc-creator/engine": "workspace:*",
    "@mc-creator/shared": "workspace:*",
    "@mc-creator/shell": "workspace:*",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pako": "^2.0.3",
    "vitest": "^2.0.0"
  }
}
