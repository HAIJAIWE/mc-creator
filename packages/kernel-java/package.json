{
  "name": "@mc-creator/kernel-java",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MC 全链路 AI 工作台 · Java 内核（客户端实例，§5）。实现 KernelContract；外壳只依赖 @mc-creator/contract，不 import 内核实现（§2.2）。",
  "main": "./src/index.ts",
